# Développement local uniquement. INSTALL/install.sh génère les secrets de
# production et écrit apps/api/.env sur le serveur.
AUXINUX_PORT=3001
AUXINUX_DATA_DIR=./.local-data
AUXINUX_DB=./.local-data/db/auxinux.sqlite
AUXINUX_RUNNER_SOCK=/run/auxinuxvirtual.sock
AUXINUX_SESSION_SECRET=replace-with-at-least-32-random-characters
AUXINUX_SECURE_COOKIE=0
AUXINUX_MAX_URL_DOWNLOADS=3

# Hôte public utilisé pour les URL de console retournées aux clients.
# AUXINUX_PUBLIC_HOST=virtua.example.net

# Clé distincte recommandée pour les jetons du client desktop.
# AUXINUX_DESKTOP_TOKEN_SECRET=replace-with-a-dedicated-random-secret
