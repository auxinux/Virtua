# Exemple de développement. En production, vdm-install.sh écrit
# /etc/auxinux-vdm.env avec des secrets aléatoires.
AUXINUX_VDM_PORT=3002
AUXINUX_VDM_DATA_DIR=./.local-vdm-data
AUXINUX_VDM_DB=./.local-vdm-data/vdm.sqlite
AUXINUX_VDM_SESSION_SECRET=replace-with-at-least-32-random-characters
AUXINUX_VDM_ENCRYPTION_KEY=replace-with-a-dedicated-random-secret
AUXINUX_VDM_SECURE_COOKIE=0
AUXINUX_VDM_TRUST_PROXY=0
AUXINUX_VDM_NODE_TIMEOUT_MS=15000
AUXINUX_VDM_NODE_RETRIES=1
